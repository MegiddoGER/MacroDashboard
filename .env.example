# =============================================================================
# MacroDashboard — Umgebungsvariablen (.env)
# =============================================================================
# Vorlage — kopieren nach .env und Werte eintragen. Enthält KEINE echten Secrets.
# Die echte .env ist in .gitignore und wird nie committet.
#
# LEGENDE — Status der Variablen:
#   [AKTIV]  wird aus dieser Datei gelesen; leer = Vorgabewert aus dem Code
#   [DB+ENV] Token: DB-Setting (/settings) hat Vorrang, sonst dieser Wert
#
# Geladen wird die Datei von config.py (python-dotenv), das jedes Modul
# importiert, das eine Einstellung braucht. Echte OS-Umgebungsvariablen haben
# Vorrang vor den Werten hier (override=False) — relevant im Serverbetrieb.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APIs MIT TOKEN (kostenpflichtig / registrierungspflichtig)
# -----------------------------------------------------------------------------

# Quiver Quantitative — Institutionelle Holdings (13F), Kongress-Trades, Insider
# Endpunkt : https://api.quiverquant.com/beta
# Auth     : Bearer Token
# Nutzung  : services/quiver.py
# Fallback : yfinance (weniger Daten), wenn kein Token gesetzt ist
# Registr. : https://www.quiverquant.com/
# Status   : [DB+ENV] — services/quiver.py:_get_token() -> config.get_api_token()
QUIVER_API_TOKEN=your_token_here

# Finnhub — Company News (englischsprachige Einzelaktien-News)
# Endpunkt : https://finnhub.io/api/v1/company-news
# Auth     : Token als Query-Parameter ?token=
# Nutzung  : services/news.py:137-144
# Fallback : Google-News-RSS, wenn kein Token gesetzt ist
# Registr. : https://finnhub.io/register  (Free Tier: 60 Requests/Minute)
# Status   : [DB+ENV] — services/news.py:get_company_news() -> config.get_api_token()
FINNHUB_API_TOKEN=your_token_here


# -----------------------------------------------------------------------------
# 2. APIs OHNE TOKEN — aber mit Identifikationspflicht
# -----------------------------------------------------------------------------

# SEC EDGAR verlangt laut Fair-Access-Policy einen User-Agent mit echter
# Kontakt-E-Mail. Im Code steht aktuell der Platzhalter
# "MacroDashboard contact@example.com" — das kann zu 403-Sperren führen.
# Endpunkte: https://www.sec.gov/files/company_tickers.json
#            https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json
# Nutzung  : services/market_data.py (3 Aufrufe), via config.SEC_USER_AGENT
# Status   : [AKTIV] — Vorgabe ohne .env: "MacroDashboard contact@example.com"
SEC_USER_AGENT=MacroDashboard deine-echte-mail@example.com

# Generischer Browser-User-Agent für Scraping-Quellen (Wikipedia, NASDAQ Trader)
# Nutzung  : services/market_data.py, services/screener.py — config.SCRAPER_USER_AGENT
# Status   : [AKTIV]
SCRAPER_USER_AGENT=Mozilla/5.0

# User-Agent für die Kadoa-Kongressdaten
# Nutzung  : services/congress_data.py — config.CONGRESS_USER_AGENT
# Status   : [AKTIV]
CONGRESS_USER_AGENT=MacroDashboard/1.0


# -----------------------------------------------------------------------------
# 3. APIs OHNE TOKEN — kein Secret nötig, nur zur Übersicht
# -----------------------------------------------------------------------------
# Alle folgenden Quellen brauchen KEINEN Schlüssel. Sie stehen hier, damit die
# Datei eine vollständige Liste der externen Abhängigkeiten des Projekts ist.
#
#   yfinance (Yahoo Finance)   inoffiziell, kein Key
#                              services/market_data.py, portfolio.py, risk.py,
#                              screener.py, options.py, forex.py, earnings.py,
#                              fundamental.py, news.py, watchlist.py,
#                              market_data_batch.py
#
#   FRED (via pandas_datareader)   Makrodaten, z. B. FPCPITOTLZGDEU
#                              services/market_data.py:561
#
#   Eurostat SDMX 2.1          https://ec.europa.eu/eurostat/api/dissemination/
#                              services/market_data.py:536
#
#   SEC EDGAR                  siehe SEC_USER_AGENT oben
#
#   NASDAQ Trader SymDir       nasdaqlisted.txt / otherlisted.txt / otclist.txt
#                              services/market_data.py:603, :617, :635
#
#   Wikipedia                  S&P-500-Konstituenten
#                              services/market_data.py:986, screener.py:43
#                              sowie die Spalte "Date added" (Aufnahmedatum)
#                              für die Survivorship-Prüfung P4-07
#                              services/index_membership.py
#
#   Kadoa Congress Trading     raw.githubusercontent.com/kadoa-org/
#                              congress-trading-monitor
#                              services/congress_data.py:22
#
#   RSS-Feeds (feedparser)     Google News, Tagesschau, Handelsblatt,
#                              CNBC, Nikkei Asia
#                              services/news.py:17-28


# -----------------------------------------------------------------------------
# 4. Anwendungs-Konfiguration
# -----------------------------------------------------------------------------

# Datenbank — Vorgabe ist data/macrodashboard.db (absoluter Pfad, SQLite,
# WAL + Foreign Keys). NUR setzen, wenn eine andere DB genutzt werden soll:
#   DATABASE_URL=postgresql://user:pass@localhost/macrodashboard
# Achtung: relative SQLite-Pfade hängen vom Arbeitsverzeichnis ab und legen
# aus einem anderen cwd heraus eine zweite, leere DB an. Absolut angeben.
# Nutzung  : database.py
# Status   : [AKTIV] — leer/auskommentiert = Vorgabepfad
# DATABASE_URL=

# Server-Bind — launcher.py, via config.APP_HOST / config.APP_PORT
# Fuer Zugriff aus dem LAN: APP_HOST=0.0.0.0 (Achtung: keine Authentifizierung!)
# Status   : [AKTIV]
APP_HOST=127.0.0.1
APP_PORT=8501

# Uhrzeit des täglichen Snapshot-Laufs (CET, nach Xetra-Schluss)
# Nutzung  : snapshot_engine/scheduler.py — config.SNAPSHOT_RUN_TIME
# Status   : [AKTIV]
SNAPSHOT_RUN_TIME=18:30
